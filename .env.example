# Copy to .env (next to docker-compose.yml) to override the defaults.

# Host ports
DB_PORT=5433
API_PORT=4100
WEB_PORT=5174

# Use a long random string anywhere other than your laptop.
JWT_SECRET=local-development-secret-change-me-0123456789

# Create demo@example.com / demo-password with sample documents on start.
SEED_DEMO=true

LOG_LEVEL=info
