# Used when running the API outside Docker (uvicorn app.main:app).
DATABASE_URL=postgresql+psycopg://annotate:annotate@localhost:5433/annotate
JWT_SECRET=local-development-secret-change-me-0123456789
ACCESS_TOKEN_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
MAX_UPLOAD_MB=10
LOG_LEVEL=info

# Failed sign-ins per email and address within the window, and sign-ups per
# address per hour. 0 turns a limit off.
LOGIN_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15
REGISTRATIONS_PER_HOUR=5

# Importing documents from a url: download timeout, and whether hosts on
# private networks (localhost, 10.x, 192.168.x...) may be fetched.
IMPORT_TIMEOUT_SECONDS=15
IMPORT_ALLOW_PRIVATE=false
